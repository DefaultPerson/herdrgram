# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed user IDs (comma-separated, required)
ALLOWED_USERS=123456789,987654321

# Tmux session name (optional, defaults to "ccgram")
TMUX_SESSION_NAME=ccgram

# Monitor polling interval in seconds (optional, defaults to 2.0)
MONITOR_POLL_INTERVAL=2.0

# Multi-instance: Telegram group chat ID this instance owns (optional)
# When set, this instance only processes updates from this group.
# Get the ID via @userinfobot or @RawDataBot in your group.
# CCGRAM_GROUP_ID=-1001234567890

# Per-provider launch command overrides (optional)
# CCGRAM_CLAUDE_COMMAND=my-claude-wrapper (defaults to "claude")
# CCGRAM_CODEX_COMMAND=my-codex-wrapper (defaults to "codex")
# CCGRAM_GEMINI_COMMAND=my-gemini-wrapper (defaults to "gemini")
#
# Claude config directory (optional, defaults to ~/.claude)
# For Claude wrappers (ce, cc-mirror, zai) that use a different config location.
# Affects hook install, command discovery, and session monitoring.
# CLAUDE_CONFIG_DIR=~/.claude-custom

# Default provider for new topics (optional, defaults to "claude")
# Options: claude, codex, gemini, pi, shell
# CCGRAM_PROVIDER=claude

# Show hidden (dot) directories in the directory browser (optional, defaults to false)
# CCGRAM_SHOW_HIDDEN_DIRS=false

# Ack reaction emoji for forwarded messages (optional, empty = disabled)
# CCGRAM_ACK_REACTION=

# Tool-call visibility in transcripts (optional, defaults to true = hidden)
# CCGRAM_HIDE_TOOL_CALLS=true

# Hide transient status bubbles with elapsed time and toolbar buttons (optional)
# CCGRAM_HIDE_STATUS=true

# Echo what is typed in the terminal back into the topic (optional, defaults to true)
# Set false to keep the topic to the agent's side of the conversation.
# Messages sent from Telegram are deduplicated separately and are unaffected.
# CCGRAM_ECHO_USER_MESSAGES=true

# Desktop notification when a Telegram message lands in a pane (optional, defaults to false)
# herdr backend only ("herdr notification show", silent); ignored elsewhere.
# CCGRAM_HERDR_NOTIFY_ON_INJECT=false

# Status emoji and RC/YOLO badges in topic names (optional, defaults to true)
# Set false for plain topic titles: the name is the display name and nothing
# else, and a state change no longer renames the topic at all.
# CCGRAM_TOPIC_NAME_DECORATIONS=true

# Random icon on every topic CCGram creates (optional, defaults to false)
# Set true to give each new topic a random icon from Telegram's forum icon set
# and a random icon color, so topics are easy to tell apart. Falls back to the
# color alone where a chat refuses custom icons.
# CCGRAM_TOPIC_RANDOM_ICON=false

# Push a Telegram topic rename into the multiplexer (optional, defaults to true)
# Set false to leave names flowing multiplexer -> Telegram only. On herdr the
# push is a "tab rename", which relabels the tab for every pane sharing it.
# CCGRAM_MUX_RENAME_FROM_TELEGRAM=true

# Offer a topic instead of creating one (optional, defaults to false)
# Set true and a newly discovered session posts one message to the General
# topic with "Open topic" / "Hide" buttons; the topic is created only when the
# offer is accepted, and the last few messages are replayed into it.
# CCGRAM_TOPIC_ON_DEMAND=false

# Replay the last N messages into a newly bound topic (optional, defaults to 0)
# 0 is the upstream behaviour: a topic bound to a session that has been running
# for a while starts empty and shows only what happens next. Set 10 and every
# topic CCGram binds -- auto-created, recreated after a delete, opened from an
# on-demand offer, or picked out of /new -- opens with a header saying how many
# messages were skipped, then the last N. Live delivery resumes from the end of
# the transcript as it stood when the topic opened, so nothing is sent twice.
# CCGRAM_TOPIC_BACKFILL_MESSAGES=0

# Wait for herdr to name the agent session (optional, defaults to false)
# Set true and a herdr record without a named session is not adopted or
# offered. herdr reports a starting agent seconds before it can name its
# session, and the two identities differ, so adopting the first costs a topic
# that dies when the second arrives. The record stays visible to liveness.
# CCGRAM_HERDR_REQUIRE_NATIVE_SESSION=false

# How a herdr topic is labelled (optional, defaults to full)
# full = provider, workspace, tab and pane joined into one long label.
# tab  = the herdr tab label alone, so a topic reads like the herdr sidebar;
#        the pane is appended only when two agents share one tab.
# CCGRAM_HERDR_TOPIC_LABEL=full

# Let the backend's own agent status decide (optional, defaults to false)
# Upstream scrapes the terminal first and asks the backend only when the
# scrapers found nothing, so anything that looks like a spinner outvotes the
# backend that actually knows -- Claude Code keeps its spinner glyph on the
# finished-turn line, and the topic can type forever. Set true and herdr's
# idle/done ends the turn whatever the screen shows, while working and
# blocked still take their label (and prompt keyboard) from the screen.
# Backends without native agent status (tmux) ignore it.
# CCGRAM_HERDR_NATIVE_STATUS_AUTHORITY=false

# Ephemeral tools mode (optional, defaults to false)
# CCGRAM_EPHEMERAL_TOOLS=false

# Status emoji mode: "system" (green=working) or "user" (green=ready) (optional)
# CCGRAM_STATUS_MODE=system

# Status polling interval in seconds (optional, defaults to 1.0)
# CCGRAM_STATUS_POLL_INTERVAL=1.0

# Pane lifecycle notifications (optional, defaults to false)
# CCGRAM_PANE_LIFECYCLE_NOTIFY=false

# Kill the window when its topic is closed or deleted (optional, defaults to false)
# Default: the window survives and can be rebound from the window picker.
# CCGRAM_KILL_ON_TOPIC_CLOSE=false

# Delete instead of close a topic on autoclose (optional, defaults to false)
# Deletion is irreversible and removes the topic history; falls back to close.
# CCGRAM_DELETE_TOPIC_ON_AUTOCLOSE=false

# --- Toolbar ----------------------------------------------------------
# Path to custom toolbar.toml (optional)
# CCGRAM_TOOLBAR_CONFIG=~/.ccgram/toolbar.toml

# --- LLM (shell command generation + completion summaries) -------------
# Leave CCGRAM_LLM_PROVIDER empty to disable (shell forwards raw, no summaries)
# CCGRAM_LLM_PROVIDER=openai
# CCGRAM_LLM_API_KEY=sk-...
# CCGRAM_LLM_BASE_URL=
# CCGRAM_LLM_MODEL=gpt-4o-mini
# CCGRAM_LLM_TEMPERATURE=0.1

# --- Mini App Dashboard (optional) ------------------------------------
# Requires externally-reachable HTTPS endpoint (TLS termination + reverse proxy)
# CCGRAM_MINIAPP_BASE_URL=https://example.com
# CCGRAM_MINIAPP_HOST=127.0.0.1

# --- Voice message transcription (Whisper API) ----------------------------
# Enable by setting CCGRAM_WHISPER_PROVIDER to "openai" or "groq".
# Leave empty (default) to disable.
#
# Option A: Groq (recommended)
# CCGRAM_WHISPER_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
#
# Option B: OpenAI
# CCGRAM_WHISPER_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#
# Option C: Any OpenAI-compatible endpoint
# CCGRAM_WHISPER_PROVIDER=openai
# CCGRAM_WHISPER_API_KEY=your_key
# CCGRAM_WHISPER_BASE_URL=http://localhost:8000/v1
# CCGRAM_WHISPER_MODEL=whisper-1
#
# Optional tweaks (apply to all providers):
# CCGRAM_WHISPER_MODEL=whisper-large-v3-turbo
# CCGRAM_WHISPER_LANGUAGE=en
# CCGRAM_VOICE_AUTOSEND=true  # skip confirmation; default false

# --- Voice replies (TTS) --------------------------------------------------
# Enable by setting CCGRAM_TTS_PROVIDER to "edge" or "openai".
# Leave empty (default) to disable. Requires: pip install ccgram[tts]
#
# CCGRAM_TTS_PROVIDER=edge
# CCGRAM_TTS_VOICE=en-US-EmmaMultilingualNeural
# CCGRAM_TTS_API_KEY=
# CCGRAM_TTS_MODEL=

# --- Shell provider prompt mode ---------------------------------------
# CCGRAM_PROMPT_MODE=wrap
# CCGRAM_PROMPT_MARKER=ccgram
